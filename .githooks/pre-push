#!/bin/sh
# Stops a push only when quality/lint-new.sh finds something new in what the branch adds to origin/master (Android
# Lint beyond the baseline, Checkstyle on added lines). Anything else is noted and the push goes on.
[ -f quality/lint-new.sh ] || exit 0

blocked=0
fetched=

while read -r _ sha remote_ref _; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$sha" in *[!0]*) ;; *) continue ;; esac
  # Lint and Checkstyle read the files on disk, so they can only judge the commit that is checked out.
  if [ "$sha" != "$(git rev-parse HEAD)" ]; then
    echo "pre-push: $remote_ref is not the checked-out commit, checks skipped."
    continue
  fi
  # This clone's origin/master may be behind, and then master's newer code would look like part of the branch.
  if [ -z "$fetched" ]; then
    fetched=1
    GIT_TERMINAL_PROMPT=0 git fetch -q --no-write-fetch-head origin master 2>/dev/null
  fi
  output=$(sh quality/lint-new.sh 2>&1 </dev/null)
  code=$?
  # lint-new.sh exits 1 for findings and 2 when a check could not run.
  case $code in
    0) ;;
    1)
      printf '%s\n' "$output"
      blocked=1
      ;;
    *) printf '%s\npre-push: quality/lint-new.sh could not run (exit %s), pushing anyway.\n' "$output" "$code" ;;
  esac
done

if [ "$blocked" = 1 ] && [ -n "$(git status --porcelain --untracked-files=no -- gleap 2>/dev/null)" ]; then
  echo "Uncommitted changes under gleap/ were checked too."
fi
[ "$blocked" = 0 ] || echo "Push stopped. Fix the findings above, commit and push again."
exit "$blocked"
